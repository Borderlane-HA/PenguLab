{
  "id": "opnsense",
  "name": "OPNsense",
  "version": "1.0.0",
  "category": "Network",
  "author": "Borderlane-HA",
  "description": "Read-only OPNsense health monitoring through API key/secret authentication.",
  "icon": "firewall",
  "connector": "connector.php",
  "permissions": ["network.http", "secrets.read"],
  "integration": {
    "type": "opnsense",
    "name": "OPNsense",
    "description": "OPNsense Firewall",
    "fields": [
      {"key": "base_url", "label": "URL", "type": "url", "placeholder": "https://opnsense.local", "required": true},
      {"key": "api_key", "label": "API key", "type": "password", "secret": true, "required": true},
      {"key": "api_secret", "label": "API secret", "type": "password", "secret": true, "required": true},
      {"key": "verify_tls", "label": "Verify TLS certificate", "type": "boolean", "default": true}
    ]
  },
  "widgets": [
    {"type": "integration-summary", "integrationType": "opnsense", "name": "OPNsense Health", "description": "System status and basic health.", "icon": "firewall", "defaultSize": [4, 2]}
  ]
}
