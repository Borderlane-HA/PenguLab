{
  "id": "adguardhome",
  "name": "AdGuard Home",
  "version": "1.0.0",
  "category": "DNS",
  "author": "Borderlane-HA",
  "description": "AdGuard Home monitoring using its documented /control API.",
  "icon": "shield-check",
  "connector": "connector.php",
  "permissions": ["network.http", "secrets.read"],
  "integration": {
    "type": "adguardhome",
    "name": "AdGuard Home",
    "description": "AdGuard Home",
    "fields": [
      {"key": "base_url", "label": "URL", "type": "url", "placeholder": "https://adguard.local", "required": true},
      {"key": "username", "label": "Username", "type": "text"},
      {"key": "password", "label": "Password", "type": "password", "secret": true},
      {"key": "verify_tls", "label": "Verify TLS certificate", "type": "boolean", "default": true}
    ]
  },
  "widgets": [
    {"type": "integration-summary", "integrationType": "adguardhome", "name": "AdGuard Summary", "description": "Queries, blocked percentage and protection state.", "icon": "shield-check", "defaultSize": [4, 2]}
  ]
}
