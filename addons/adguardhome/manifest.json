{
  "id": "adguardhome",
  "name": "AdGuard Home",
  "version": "1.5.0",
  "category": "DNS",
  "author": "Borderlane-HA",
  "description": "AdGuard Home monitoring and protection controls using its documented /control API.",
  "icon": "shield-check",
  "connector": "connector.php",
  "permissions": [
    "network.http",
    "secrets.read",
    "service.control"
  ],
  "integration": {
    "type": "adguardhome",
    "name": "AdGuard Home",
    "description": "AdGuard Home",
    "fields": [
      {
        "key": "base_url",
        "label": "URL",
        "type": "url",
        "placeholder": "https://adguard.local",
        "required": true
      },
      {
        "key": "username",
        "label": "Username",
        "type": "text"
      },
      {
        "key": "password",
        "label": "Password",
        "type": "password",
        "secret": true
      },
      {
        "key": "verify_tls",
        "label": "Verify TLS certificate",
        "type": "boolean",
        "default": true
      }
    ],
    "widget_options": [
      {
        "key": "show_stats",
        "label": "DNS-Statistiken anzeigen",
        "type": "boolean",
        "default": true
      },
      {
        "key": "show_graph",
        "label": "Mini-Graph für DNS-Aktivität anzeigen",
        "type": "boolean",
        "default": true
      },
      {
        "key": "show_controls",
        "label": "Schutz-Steuerung anzeigen",
        "type": "boolean",
        "default": true
      },
      {
        "key": "show_recent_blocked",
        "label": "Letzte blockierte Domains anzeigen",
        "type": "boolean",
        "default": false
      },
      {
        "key": "recent_blocked_count",
        "label": "Anzahl blockierter Domains",
        "type": "select",
        "default": "3",
        "options": [
          {
            "value": "3",
            "label": "3 Domains"
          },
          {
            "value": "5",
            "label": "5 Domains"
          },
          {
            "value": "10",
            "label": "10 Domains"
          }
        ]
      },
      {
        "key": "refresh_interval",
        "label": "Live-Aktualisierung",
        "type": "select",
        "default": "10",
        "options": [
          {
            "value": "5",
            "label": "alle 5 Sekunden"
          },
          {
            "value": "10",
            "label": "alle 10 Sekunden"
          },
          {
            "value": "15",
            "label": "alle 15 Sekunden"
          },
          {
            "value": "30",
            "label": "alle 30 Sekunden"
          },
          {
            "value": "60",
            "label": "alle 60 Sekunden"
          }
        ]
      }
    ]
  },
  "widgets": [
    {
      "type": "integration-summary",
      "integrationType": "adguardhome",
      "name": "AdGuard Summary",
      "description": "Queries, blocked percentage and protection controls.",
      "icon": "shield-check",
      "defaultSize": [
        4,
        2
      ]
    }
  ]
}
