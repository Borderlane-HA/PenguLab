{
  "id": "generic-api",
  "name": "Generic API",
  "version": "1.0.0",
  "category": "Developer",
  "author": "Borderlane-HA",
  "description": "Connect a JSON HTTP endpoint without writing a dedicated PenguLab package.",
  "icon": "api",
  "connector": "connector.php",
  "permissions": ["network.http", "secrets.read"],
  "integration": {
    "type": "generic-api",
    "name": "Generic JSON API",
    "description": "HTTP JSON endpoint",
    "fields": [
      {"key": "base_url", "label": "Endpoint URL", "type": "url", "placeholder": "https://service.local/api/status", "required": true},
      {"key": "bearer_token", "label": "Bearer token", "type": "password", "secret": true},
      {"key": "username", "label": "Basic auth username", "type": "text"},
      {"key": "password", "label": "Basic auth password", "type": "password", "secret": true},
      {"key": "verify_tls", "label": "Verify TLS certificate", "type": "boolean", "default": false}
    ]
  },
  "widgets": [
    {"type": "integration-summary", "integrationType": "generic-api", "name": "JSON API Summary", "description": "Show scalar values returned by an HTTP JSON endpoint.", "icon": "api", "defaultSize": [4, 2]}
  ]
}
