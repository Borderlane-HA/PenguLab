{
  "id": "pihole",
  "name": "Pi-hole",
  "version": "1.2.0",
  "category": "DNS",
  "author": "Borderlane-HA",
  "description": "Pi-hole v6 monitoring and protection controls through the official session-based API.",
  "icon": "shield",
  "connector": "connector.php",
  "permissions": [
    "network.http",
    "secrets.read",
    "service.control"
  ],
  "integration": {
    "type": "pihole",
    "name": "Pi-hole",
    "description": "Pi-hole v6",
    "fields": [
      {
        "key": "base_url",
        "label": "URL",
        "type": "url",
        "placeholder": "https://pi.hole",
        "required": true
      },
      {
        "key": "password",
        "label": "Application password",
        "type": "password",
        "secret": true
      },
      {
        "key": "verify_tls",
        "label": "Verify TLS certificate",
        "type": "boolean",
        "default": true
      }
    ],
    "widget_options": [
      {
        "key": "show_stats",
        "label": "DNS-Statistiken anzeigen",
        "type": "boolean",
        "default": true
      },
      {
        "key": "show_graph",
        "label": "Mini-Graph für DNS-Aktivität anzeigen",
        "type": "boolean",
        "default": true
      },
      {
        "key": "show_clients",
        "label": "Aktive Clients anzeigen",
        "type": "boolean",
        "default": true
      },
      {
        "key": "show_controls",
        "label": "Schutz-Steuerung anzeigen",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "widgets": [
    {
      "type": "integration-summary",
      "integrationType": "pihole",
      "name": "Pi-hole Summary",
      "description": "Queries, blocked percentage, clients and protection controls.",
      "icon": "shield",
      "defaultSize": [
        4,
        2
      ]
    }
  ]
}
